
{
  "name": "optiqueue-monorepo",
  "private": true,
  "workspaces": [
    "Patient-App",
    "Admin-Panel",
    "Live-Queue"
  ],
  "scripts": {
    "patient": "npm run start --workspace=Patient-App -- --port 8081",
    "admin": "npm run start --workspace=Admin-Panel -- --port 8082",
    "live": "npm run start --workspace=Live-Queue -- --port 8083",
    "dev": "concurrently -k \"npm run patient\" \"npm run admin\" \"npm run live\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
